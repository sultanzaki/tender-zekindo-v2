# Supabase project connection.
#
# SUPABASE_SERVICE_ROLE_KEY is used server-side only (src/lib/supabase-server.ts)
# for everything the app touches — tenders, profiles, sessions, all of it.
# There is no NEXT_PUBLIC_ variant on purpose, and no anon key at all: this
# app doesn't use Supabase Auth (see src/lib/auth/session.ts for the
# self-hosted email+password auth instead), so nothing needs public access.
# Every table has RLS enabled with no policies — only this key can read/write.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional email reminders (server only)
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
REMINDER_RECIPIENTS=
CRON_SECRET=
APP_URL=

# Optional: encrypts two-factor secrets at rest (AES-256-GCM). Any string of 32+
# characters. Set it before people enrol; losing it means affected users need an
# administrator to reset their 2FA.
TWO_FACTOR_ENCRYPTION_KEY=

# Optional: security alert emails (failed-login bursts, lockouts, exports, role
# changes, deletions, 2FA resets). Comma separated; uses the Resend settings above.
SECURITY_ALERT_RECIPIENTS=
